# FastAPI server
HOST=127.0.0.1
PORT=8000

# Safety defaults
DEFAULT_PROTOCOL=ISO_9141_2
ENABLE_HARDWARE=false

# OBDLink serial adapter settings
OBDLINK_PORT=/dev/cu.OBDLinkMX74465
OBDLINK_BAUD=115200
OBDLINK_TIMEOUT_SECONDS=1.0

# LM Studio local Llama-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=local-model

# OpenAI second-opinion hook
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
