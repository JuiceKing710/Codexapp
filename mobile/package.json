    "build:ios": "npm run sync && npx cap build ios",
    "build:android": "npm run sync && npx cap build android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor-community/bluetooth-le": "^7.1.0"
  }
}
